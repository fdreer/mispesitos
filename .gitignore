# dependencies
# Las entradas de yarn (.yarn/*, .pnp*) y de npm (npm-debug.log) que traía
# create-next-app se fueron: el proyecto es pnpm-only y esos archivos no los
# puede generar nadie acá.
/node_modules

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
.pnpm-debug.log*

# env files
.env*.local

# typescript
*.tsbuildinfo
next-env.d.ts

# Config local del launcher del editor
/.claude/

# Estado local de las herramientas de agentes: no es del proyecto.
/.agents/
/.playwright/
/.playwright-cli/
/.superpowers/
skills-lock.json

# Variables de entorno para Docker Compose (ver .env.example)
/.env
