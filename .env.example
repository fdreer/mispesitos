# Postgres de Supabase — usar el TRANSACTION POOLER (puerto 6543), no la conexión directa.
# Motivo: en serverless cada request abre su propia conexión y la directa se agota.
# RLS anda con cualquiera de los dos; lo que sí exige el pooler es `prepare: false`
# en el cliente de postgres.js, porque pgbouncer en modo transacción no soporta
# prepared statements con nombre.
DATABASE_URL="postgresql://postgres.[REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres"

# Secreto de firma de sesiones. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# URL base de la app. En desarrollo, http://localhost:3000
BETTER_AUTH_URL="http://localhost:3000"

# Credenciales OAuth de Google Cloud. La URI de redirección autorizada tiene que
# ser http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
