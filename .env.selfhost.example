# Instalación propia con Docker Compose. Copialo a `.env` (ignorado por git)
# y completalo. Ver la sección "Instalación propia" del README.
#
# Las contraseñas van en HEX (openssl rand -hex 24): viajan dentro de URLs de
# conexión y así no hay nada que escapar.

# Contraseña del superusuario de Postgres. Sólo la usa el paso de migraciones.
POSTGRES_PASSWORD=""

# Contraseña de app_user, el rol con el que conecta la app (sin BYPASSRLS).
# Tiene que ser distinta de la de arriba.
APP_USER_PASSWORD=""

# Secreto de firma de sesiones. Generar con: openssl rand -base64 32
BETTER_AUTH_SECRET=""

# La URL pública con la que entrás a la app, exacta (esquema, dominio y puerto
# si no es el estándar). Con ella se arman los links de invitación y la
# vuelta de Google. Ej.: https://pesitos.midominio.com
BETTER_AUTH_URL="http://localhost:3000"

# Puerto del host donde se publica la app.
APP_PORT=3000

# Opcional: ingreso con Google. La URI de redirección autorizada en Google
# Cloud es <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
